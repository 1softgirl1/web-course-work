meta {
  name: 07 refresh doctor session
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "{{doctorRefreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("oldDoctorRefreshToken", bru.getVar("doctorRefreshToken"));
  bru.setVar("doctorToken", body.accessToken);
  bru.setVar("doctorRefreshToken", body.refreshToken);
}

tests {
  test("refresh returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("doctor refresh rotates token pair", function () {
    const body = res.getBody();
    expect(body.accessToken).to.be.a("string");
    expect(body.refreshToken).to.be.a("string");
    expect(body.user.role).to.equal("DOCTOR");
  });
}
