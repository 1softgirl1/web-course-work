meta {
  name: 14 refresh with stale bearer header
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
  Authorization: Bearer invalid-stale-access-token
}

body:json {
  {
    "refreshToken": "{{doctorRefreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("doctorToken", body.accessToken);
  bru.setVar("doctorRefreshToken", body.refreshToken);
}

tests {
  test("refresh ignores stale bearer header and returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("fresh token pair is returned", function () {
    const body = res.getBody();
    expect(body.accessToken).to.be.a("string");
    expect(body.refreshToken).to.be.a("string");
  });
}
