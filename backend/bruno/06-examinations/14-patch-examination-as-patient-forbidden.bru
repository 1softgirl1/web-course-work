}

patch {
  url: {{baseUrl}}/api/patients/{{seedOwnPatientId}}/examinations/{{seedOwnExaminationId}}
  body: json
}

headers {
  Authorization: Bearer {{patientToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Should be forbidden"
  }
}

tests {
  test("patient cannot patch examination", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
