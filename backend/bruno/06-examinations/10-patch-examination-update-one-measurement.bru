meta {
  name: 10 patch examination update one measurement
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/api/patients/{{createdPatientId}}/examinations/{{createdExaminationId}}
  body: json
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "measurements": [
      {
        "characteristicCode": "weight_kg",
        "value": 76,
        "comment": "Corrected from Bruno"
      }
    ]
  }
}

tests {
  test("doctor can update one measurement without removing others", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.measurements.length).to.equal(2);
    const weightKg = body.measurements.find(item => item.characteristicCode === "weight_kg");
    const efPct = body.measurements.find(item => item.characteristicCode === "ef_pct");
    expect(weightKg.value).to.equal("76");
    expect(weightKg.comment).to.equal("Corrected from Bruno");
    expect(efPct).to.exist;
  });
}
