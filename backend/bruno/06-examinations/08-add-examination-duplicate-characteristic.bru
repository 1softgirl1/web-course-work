meta {
  name: 08 add examination duplicate characteristic
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/patients/{{createdPatientId}}/examinations
  body: json
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Duplicate metrics",
    "examDate": "2026-04-13",
    "comment": "Should fail",
    "measurements": [
      {
        "characteristicCode": "weight_kg",
        "value": 70
      },
      {
        "characteristicCode": "weight_kg",
        "value": 71
      }
    ]
  }
}

tests {
  test("duplicate characteristicCode returns 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
