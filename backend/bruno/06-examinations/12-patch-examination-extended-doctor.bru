meta {
  name: 12 patch examination extended doctor
  type: http
  seq: 12
}

patch {
  url: {{baseUrl}}/api/patients/{{seedForeignPatientId}}/examinations/{{seedForeignExaminationId}}
  body: json
}

headers {
  Authorization: Bearer {{extendedDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Extended doctor corrected follow-up"
  }
}

tests {
  test("extended doctor can patch foreign-region examination", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.title).to.equal("Extended doctor corrected follow-up");
  });
}
