meta {
  name: 09 add examination unknown characteristic
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/patients/{{createdPatientId}}/examinations
  body: json
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Unknown metric",
    "examDate": "2026-04-13",
    "comment": "Should fail",
    "measurements": [
      {
        "characteristicCode": "unknown_metric",
        "value": 70
      }
    ]
  }
}

tests {
  test("unknown characteristic returns 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
