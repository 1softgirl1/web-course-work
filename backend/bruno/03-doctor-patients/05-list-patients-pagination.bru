meta {
  name: 05 list patients pagination
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/doctor/patients?scope=all&page=0&limit=2
}

headers {
  Authorization: Bearer {{doctorToken}}
}

tests {
  test("pagination returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("pagination honors limit", function () {
    const body = res.getBody();
    expect(body.page).to.equal(0);
    expect(body.limit).to.equal(2);
    expect(body.items.length).to.be.at.most(2);
  });
}
