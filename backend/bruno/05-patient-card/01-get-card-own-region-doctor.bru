meta {
  name: 01 get card own region doctor
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/patients/{{seedOwnPatientId}}
}

headers {
  Authorization: Bearer {{doctorToken}}
}

tests {
  test("own region doctor gets full card", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.viewMode).to.equal("FULL");
    expect(body).to.not.have.property("lastName");
    expect(body).to.not.have.property("firstName");
    expect(body).to.not.have.property("middleName");
    expect(body.patientCode).to.equal(bru.getEnvVar("seedOwnPatientCode"));
  });
}
