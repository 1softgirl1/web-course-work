meta {
  name: 03 get card patient self
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/patients/{{seedOwnPatientId}}
}

headers {
  Authorization: Bearer {{patientToken}}
}

tests {
  test("patient gets own full card", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.viewMode).to.equal("FULL");
    expect(body.patientCode).to.equal(bru.getEnvVar("seedOwnPatientCode"));
  });
}
