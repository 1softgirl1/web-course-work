meta {
  name: 01 create patient happy path
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/doctor/patients
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "birthDate": "1977-05-11",
    "diagnosis": "Bruno create flow diagnosis",
    "regionId": 1,
    "valve": {
      "name": "Medtronic Evolut",
      "size": "26 mm",
      "material": "Bioprosthetic"
    },
    "operationParameters": {
      "anesthesia": "General anesthesia",
      "durationMinutes": 120,
      "deliverySystem": "Transfemoral"
    },
    "medications": "Bisoprolol 5 mg daily"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("createdPatientId", body.id);
  bru.setVar("createdPatientCode", body.patientCode);
  bru.setVar("createdPatientPassword", body.temporaryPassword);
}

tests {
  test("create patient returns 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("created patient credentials are returned", function () {
    const body = res.getBody();
    expect(body.id).to.exist;
    expect(body.patientCode).to.match(/^PT-/);
    expect(body.temporaryPassword).to.be.a("string");
    expect(body.regionId).to.equal(1);
  });
}
