meta {
  name: 02 verify created patient in own scope
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/doctor/patients?scope=own&page=0&limit=50
}

headers {
  Authorization: Bearer {{doctorToken}}
}

tests {
  test("created patient appears in own scope", function () {
    const body = res.getBody();
    const code = bru.getVar("createdPatientCode");
    expect(body.items.some(item => item.patientCode === code)).to.equal(true);
  });
}
