meta {
  name: 04 login doctor old password rejected
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{doctorEmail}}",
    "password": "{{doctorPassword}}"
  }
}

tests {
  test("old doctor password is rejected", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
