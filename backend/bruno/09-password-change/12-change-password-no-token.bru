meta {
  name: 12 change password no token
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password-change-doctor-new",
    "newPassword": "another-new-password",
    "refreshToken": "{{changeDoctorRefreshToken}}"
  }
}

tests {
  test("missing bearer returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
