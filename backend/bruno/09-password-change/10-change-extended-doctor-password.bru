meta {
  name: 10 change extended doctor password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{extendedDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{extendedDoctorPassword}}",
    "newPassword": "extended-password-changed",
    "refreshToken": "{{extendedDoctorRefreshToken}}"
  }
}

tests {
  test("extended doctor can change own password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.role).to.equal("DOCTOR_EXTENDED");
  });
}
