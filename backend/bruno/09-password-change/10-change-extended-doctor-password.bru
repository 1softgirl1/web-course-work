meta {
  name: 10 change extended doctor password
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{passwordChangeExtendedDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{passwordChangeExtendedDoctorPassword}}",
    "newPassword": "password-change-extended-new",
    "refreshToken": "{{passwordChangeExtendedDoctorRefreshToken}}"
  }
}

tests {
  test("extended doctor can change own password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.role).to.equal("DOCTOR_EXTENDED");
  });
}
