meta {
  name: 00 create doctor for password change
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/doctors
  body: json
}

headers {
  Authorization: Bearer {{extendedDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "{{passwordChangeDoctorUsername}}",
    "role": "DOCTOR",
    "lastName": "Password",
    "firstName": "Change",
    "middleName": "Doctor",
    "specialization": "Cardiologist",
    "workplace": "Bruno Password Flow Clinic",
    "regionId": 1
  }
}

script:pre-request {
  bru.setVar("passwordChangeDoctorUsername", `bruno.password.doctor.${Date.now()}@example.com`);
}

script:post-response {
  const body = res.getBody();
  bru.setVar("passwordChangeDoctorId", body.doctor.id);
  bru.setVar("passwordChangeDoctorUsername", body.doctor.username);
  bru.setVar("passwordChangeDoctorPassword", body.temporaryPassword);
}

tests {
  test("disposable doctor for password change is created", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.doctor.role).to.equal("DOCTOR");
    expect(body.temporaryPassword).to.be.a("string");
  });
}
