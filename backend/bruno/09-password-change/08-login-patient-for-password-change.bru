meta {
  name: 08 login patient for password change
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{passwordChangePatientCode}}",
    "password": "{{passwordChangePatientPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("passwordChangePatientToken", body.accessToken);
  bru.setVar("passwordChangePatientRefreshToken", body.refreshToken);
}

tests {
  test("disposable patient login returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
