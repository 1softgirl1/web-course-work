meta {
  name: 03 change doctor password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{changeDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{passwordChangeDoctorPassword}}",
    "newPassword": "password-change-doctor-new",
    "refreshToken": "{{changeDoctorRefreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("oldChangeDoctorRefreshToken", bru.getVar("changeDoctorRefreshToken"));
  bru.setVar("changeDoctorToken", body.accessToken);
  bru.setVar("changeDoctorRefreshToken", body.refreshToken);
}

tests {
  test("doctor can change own password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.accessToken).to.be.a("string");
    expect(body.refreshToken).to.be.a("string");
    expect(body.user.email).to.equal(bru.getVar("passwordChangeDoctorUsername"));
  });
}
