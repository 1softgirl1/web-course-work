meta {
  name: 11 change password wrong current
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{changeDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "wrong-password",
    "newPassword": "another-new-password",
    "refreshToken": "{{changeDoctorRefreshToken}}"
  }
}

tests {
  test("wrong current password returns 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
