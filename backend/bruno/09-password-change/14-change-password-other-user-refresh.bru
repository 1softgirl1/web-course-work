meta {
  name: 14 change password other user refresh
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{changeDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "password-change-doctor-new",
    "newPassword": "another-new-password",
    "refreshToken": "{{patientPasswordChangeRefreshToken}}"
  }
}

tests {
  test("refresh token of another user returns 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
