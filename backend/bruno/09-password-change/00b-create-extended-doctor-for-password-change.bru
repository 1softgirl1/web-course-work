meta {
  name: 00b create extended doctor for password change
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/doctors
  body: json
}

headers {
  Authorization: Bearer {{extendedDoctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "{{passwordChangeExtendedDoctorUsername}}",
    "role": "DOCTOR_EXTENDED",
    "lastName": "Password",
    "firstName": "Change",
    "middleName": "Extended",
    "specialization": "Chief cardiologist",
    "workplace": "Bruno Federal Password Flow Center",
    "regionId": 2
  }
}

script:pre-request {
  bru.setVar("passwordChangeExtendedDoctorUsername", `bruno.password.extended.${Date.now()}@example.com`);
}

script:post-response {
  const body = res.getBody();
  bru.setVar("passwordChangeExtendedDoctorId", body.doctor.id);
  bru.setVar("passwordChangeExtendedDoctorUsername", body.doctor.username);
  bru.setVar("passwordChangeExtendedDoctorPassword", body.temporaryPassword);
}

tests {
  test("disposable extended doctor for password change is created", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.doctor.role).to.equal("DOCTOR_EXTENDED");
    expect(body.temporaryPassword).to.be.a("string");
  });
}
