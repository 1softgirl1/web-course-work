meta {
  name: 00a create patient for password change
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/doctor/patients
  body: json
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "birthDate": "1978-09-09",
    "diagnosis": "Bruno password change flow",
    "regionId": 1,
    "valve": {
      "name": "Medtronic Evolut",
      "size": "26 mm",
      "material": "Bioprosthetic"
    },
    "operationParameters": {
      "anesthesia": "General anesthesia",
      "durationMinutes": 120,
      "deliverySystem": "Transfemoral"
    },
    "medications": "Bisoprolol 5 mg daily"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("passwordChangePatientId", body.id);
  bru.setVar("passwordChangePatientCode", body.patientCode);
  bru.setVar("passwordChangePatientPassword", body.temporaryPassword);
}

tests {
  test("disposable patient for password change is created", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.patientCode).to.match(/^PT-/);
    expect(body.temporaryPassword).to.be.a("string");
  });
}
