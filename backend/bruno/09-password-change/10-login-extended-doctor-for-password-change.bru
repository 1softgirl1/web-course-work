meta {
  name: 10 login extended doctor for password change
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{passwordChangeExtendedDoctorUsername}}",
    "password": "{{passwordChangeExtendedDoctorPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("passwordChangeExtendedDoctorToken", body.accessToken);
  bru.setVar("passwordChangeExtendedDoctorRefreshToken", body.refreshToken);
}

tests {
  test("disposable extended doctor login returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
