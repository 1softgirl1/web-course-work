meta {
  name: 08 change patient password
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/auth/password/change
  body: json
}

headers {
  Authorization: Bearer {{passwordChangePatientToken}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{passwordChangePatientPassword}}",
    "newPassword": "password-change-patient-new",
    "refreshToken": "{{passwordChangePatientRefreshToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("patientPasswordChangeRefreshToken", body.refreshToken);
}

tests {
  test("patient can change own password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.role).to.equal("PATIENT");
    expect(body.user.patientCode).to.equal(bru.getVar("passwordChangePatientCode"));
  });
}
