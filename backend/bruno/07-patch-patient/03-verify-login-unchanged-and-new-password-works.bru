meta {
  name: 03 verify login unchanged and new password works
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{createdPatientCode}}",
    "password": "bruno-new-password"
  }
}

tests {
  test("patched patient can login with same code and new password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.patientCode).to.equal(bru.getVar("createdPatientCode"));
  });
}
