meta {
  name: 00 create patient for patch flow
  type: http
  seq: 0
}

post {
  url: {{baseUrl}}/api/doctor/patients
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{doctorToken}}
  Content-Type: application/json
}

body:json {
  {
    "birthDate": "2014-05-11",
    "sex": "F",
    "diagnosis": "Bruno patch flow diagnosis",
    "regionId": 1,
    "operationPlace": "НМИЦ им. Е.Н. Мешалкина",
    "observationPlace": "Городская детская поликлиника №1",
    "coronaryAnatomy": "Сбалансированный тип",
    "valve": {
      "name": "Contegra",
      "size": "16 mm",
      "material": "Кондуит из яремной вены быка"
    },
    "operationParameters": {
      "anesthesia": "General anesthesia",
      "durationMinutes": 240,
      "deliverySystem": "Sternotomy"
    },
    "medications": "Aspirin 50 mg every other day"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("createdPatientId", body.id);
  bru.setVar("createdPatientCode", body.patientCode);
  bru.setVar("createdPatientPassword", body.temporaryPassword);
}

tests {
  test("patch flow patient is created", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(body.id).to.exist;
    expect(body.patientCode).to.match(/^PT-/);
    expect(body.temporaryPassword).to.be.a("string");
    expect(body.regionId).to.equal(1);
  });
}
