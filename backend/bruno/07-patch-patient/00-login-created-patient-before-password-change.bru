meta {
  name: 00 login created patient before password change
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{createdPatientCode}}",
    "password": "{{createdPatientPassword}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("oldCreatedPatientRefreshToken", body.refreshToken);
}

tests {
  test("created patient can login before password change", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.user.patientCode).to.equal(bru.getVar("createdPatientCode"));
    expect(body.refreshToken).to.exist;
  });
}
