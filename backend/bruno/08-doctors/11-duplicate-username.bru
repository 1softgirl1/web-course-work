    "firstName": "Doctor",
    "specialization": "Cardiologist",
    "workplace": "Duplicate Center",
    "regionId": 1
  }
}

tests {
  test("duplicate username returns 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
