meta {
  name: 05 reset doctor password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/doctors/{{createdDoctorId}}/password-reset
}

headers {
  Authorization: Bearer {{extendedDoctorToken}}
}

script:post-response {
  const body = res.getBody();
  bru.setVar("resetDoctorPassword", body.temporaryPassword);
}

tests {
  test("extended doctor can reset doctor password", function () {
    const body = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(body.username).to.equal(bru.getVar("updatedDoctorUsername"));
    expect(body.temporaryPassword).to.exist;
  });
}
