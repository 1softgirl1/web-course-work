COMMON_NAME=cloud
PREFIX_NAME=registry

ACTIVE_PROFILE=local

DB_NAME=registry-db
DB_USER=apiuser
DB_PASSWORD=<PASSWORD>

#PGADMIN_EMAIL=non.existing@admin.ru
#PGADMIN_PASSWORD=<PASSWORD>
#PGADMIN_SCRIPT_NAME=/registry/db/admin

JWT_SECRET=<VERY_LONG_COOL_TOKEN>
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=PT720H

VITE_BASE_PATH=/
VITE_API_BASE_URL=https://registry.kemcardio.ru/

CORS_ALLOWED_ORIGINS=https://registry.kemcardio.ru
# Backups (deploy/backup)
BACKUP_AGE_RECIPIENT=<age1... public key>
BACKUP_S3_BUCKET=<bucket>
BACKUP_S3_ACCESS_KEY=<service account key id>
BACKUP_S3_SECRET_KEY=<service account secret>
BACKUP_UI_PASSWORD=<пароль интерфейса бэкапов, от 12 символов>
BACKUP_NOTIFIER_URL=https://<домен VPS>/<путь бота>
BACKUP_NOTIFIER_TOKEN=<общий секрет с ботом>
# Existing NFS mount on the host; archives go into /opt1/registry-backups/{daily,weekly,monthly}.
BACKUP_NFS_ENABLED=true
BACKUP_NFS_PATH=/opt1
